# Copy this file to .env and add your Groq API key.
# Never commit the real key.
GROQ_API_KEY=gsk_replace_with_your_key

# Hindsight configuration approved for local development.
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_CONTROL_PLANE_URL=http://localhost:9999
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-20b
HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand
HINDSIGHT_API_WORKER_ID=hindsightops-local
HINDSIGHT_API_ENABLE_OBSERVATIONS=false
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
HINDSIGHT_API_REFLECT_MAX_COMPLETION_TOKENS=2048
HINDSIGHT_API_REFLECT_MAX_ITERATIONS=1
HINDSIGHT_API_RETAIN_CHUNK_SIZE=800
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=1024
HINDSIGHT_API_RETAIN_LLM_PROVIDER=groq
HINDSIGHT_API_RETAIN_LLM_MODEL=qwen/qwen3.8-27b

# Freelens API
APP_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://freelens:freelens-local@localhost:5433/freelens
POSTGRES_DB=freelens
POSTGRES_USER=freelens
POSTGRES_PASSWORD=freelens-local
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false

# Local MinIO. Replace with Cloudflare R2 credentials in production.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=freelens
S3_SECRET_ACCESS_KEY=freelens-local-secret
S3_BUCKET=freelens-documents
S3_MAX_UPLOAD_MB=20
MINIO_ROOT_USER=freelens
MINIO_ROOT_PASSWORD=freelens-local-secret

